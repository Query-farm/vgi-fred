# Documentation only. The worker does not load .env files automatically.
# Supply your own FRED key through the environment or a fred_api SQL secret.
FRED_API_KEY=
FRED_TIMEOUT_SECONDS=30
FRED_MAX_ATTEMPTS=4
FRED_RETRY_BUDGET_SECONDS=120
FRED_MIN_INTERVAL_SECONDS=0.55
# Optional HTTP worker authentication (separate from the FRED key).
# Omit this variable entirely when unused; an explicitly empty value is rejected.
# VGI_BEARER_TOKENS=<random-token-at-least-32-characters>=analyst
